// Cloudflare Workers config. The Worker (worker/sites.js) serves this repo's files, decides which folder each address
// may see (worker/routes.js) and answers /api/claims, /api/csp and /api/files/ (the R2 bucket below). No secrets in this file:
// the service account (SA_EMAIL, SA_KEY) is a Worker secret (wrangler secret put), kept across deploys.
// tools/fill.mjs sets the name, route, project and bucket name.
{
  "name": "facts",
  "main": "worker/sites.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // every request goes through the Worker first (it picks the folder by address); it does the folder-index and
    // trailing-slash handling itself, so Cloudflare's own are off
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // no preview link per branch or build, and no *.workers.dev address: only the real address serves the app
  "preview_urls": false,
  "workers_dev": false,
  "keep_vars": true,
  // Workers Logs: keeps console lines such as the CSP reports (worker/csp-report.js) to read in the dashboard
  "observability": { "enabled": true },
  "vars": { "FIREBASE_PROJECT": "anaesfacts-app" },
  // add: r2
  // the real address, as in worker/routes.js SITES; the first deploy adds the custom domain
  "routes": [{ "pattern": "facts.anawj.com", "custom_domain": true }]
}
